{
  "manifest_version": 3,
  "name": "Job Tab Collector",
  "version": "0.6.0",
  "description": "Collect job postings from your open tabs into a saved list, then export them as a file to hand to Claude or ChatGPT.",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "scripting",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Job Tab Collector",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
