{
  "manifest_version": 3,
  "name": "fitcheck Capture",
  "version": "0.6.0",
  "description": "Capture job postings from your open tabs — including sites AI can't fetch — into a saved list, then export them for résumé-fit analysis.",
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "scripting",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "fitcheck Capture",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
